# Template for .env.development (gitignored).
# Real values come from pss-supabase-host/connections.md — generate it with:
#   cd /path/to/pss-supabase-host
#   ./scripts/print_connections.sh > connections.md          # on the LAN
#   JUMP_HOST=root@10.0.0.84 ./scripts/print_connections.sh > connections.md   # via VPN
#
# This file is read by docker-compose.yml (dev compose) only.
# Production builds use .env.production — never this one.

HOST_DOC_ROOT=C:/dev/cad_iot

# Self-hosted Supabase on the dev Proxmox VM
NEXT_PUBLIC_SUPABASE_URL=http://10.0.0.85:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=<self-hosted-anon-jwt-from-connections.md>
SUPABASE_URL=http://10.0.0.85:8000
SUPABASE_SECRET_KEY=<self-hosted-service-role-jwt-from-connections.md>

# Adjacent services (LAN-resident — same regardless of Supabase target)
NEXT_PUBLIC_DOC_GATEWAY_BASE_URL=http://localhost:80/files
NEXT_PUBLIC_APP_URL=http://portal.localtest.me:3000
NEXT_PUBLIC_DOC_SERVICE_URL=http://10.0.0.74:3000
DOC_SERVICE_URL=http://10.0.0.74:3000
LASER_QUOTE_SERVICE_URL=http://10.0.0.74:3000
NEXT_PUBLIC_LASER_QUOTE_SERVICE_URL=http://10.0.0.74:3000
MATL_CERT_APP=C:/Dev/PSS/pss-matl-cert/app

# Nesting cutting-list filing (epic platform-portal-6gr)
NESTING_DOC_SERVICE_API_KEY=
NESTING_ISO_DESCRIPTION_ID=66
