# Template for .env.production (gitignored).
# Real values come from cloud Supabase dashboard → Settings → API
# (project ref hguvsjpmiyeypfcuvvko).
#
# This file is read by:
#   - scripts/deploy.sh / scripts/deploy-timed.sh (Pi/ghcr build path)
#   - scripts/pi-deploy.sh (Pi bootstrap)
#   - docker-compose.cloud.yml (rare: dev container against cloud)
#
# Production builds will FAIL if .env.production is missing — there is no
# silent fallback. Fill this in before invoking any deploy script.

# Cloud Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<key>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<key>

# Externally reachable URL of the gateway (must match Supabase Auth allowlist)
NEXT_PUBLIC_APP_URL=http://10.0.0.75:3000
NEXT_PUBLIC_DOC_GATEWAY_BASE_URL=http://10.0.0.75:3000/files

# Adjacent services
NEXT_PUBLIC_DOC_SERVICE_URL=http://10.0.0.74:3000
DOC_SERVICE_URL=http://10.0.0.74:3000
LASER_QUOTE_SERVICE_URL=http://10.0.0.74:3000
NEXT_PUBLIC_LASER_QUOTE_SERVICE_URL=http://10.0.0.74:3000

# Pi host paths
GATEWAY_PORT=3000
HOST_DOC_ROOT=/path/to/documents
SCANNER_DATA_DIR=//pss-dc02/CAD_IOT/documents

# Standalone matl-cert app
MATL_CERT_APP=C:/Dev/PSS/pss-matl-cert/app

# Nesting cutting-list filing (epic platform-portal-6gr)
NESTING_DOC_SERVICE_API_KEY=
NESTING_ISO_DESCRIPTION_ID=66
